  "item": [
    {
      "name": "GET - Verify Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response body is not empty\", function () {\r\n    pm.expect(pm.response.text()).to.not.be.empty;\r\n});\r\n\r\npm.test(\"Product ID exists\", function () {\r\n    let response = pm.response.json();\r\n    pm.expect(response[0].id).to.exist;\r\n});\r\n\r\npm.test(\"Check product title\", function () {\r\n    let response = pm.response.json();\r\n    pm.expect(response[0].title).to.exist;\r\n});\r\n\r\npm.test(\"Check product price\", function () {\r\n    let response = pm.response.json();\r\n    pm.expect(response[0].price).to.be.a(\"number\");\r\n});\r\n\r\npm.test(\"Check product category\", function () {\r\n    let response = pm.response.json();\r\n    pm.expect(response[0].category).to.exist;\r\n});\r\n\r\n\r\npm.test(\"All products have ID\", function () {\r\n    let response = pm.response.json();\r\n\r\n    response.forEach(function (product) {\r\n        pm.expect(product.id).to.exist;\r\n    });\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://fakestoreapi.com/products",
          "protocol": "https",
          "host": [
            "fakestoreapi",
            "com"
          ],
          "path": [
            "products"
          ]
        }
      },
      "response": []
    },
